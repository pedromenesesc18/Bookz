{
  "name": "bookz",
  "private": true,
  "version": "2.0.0",
  "description": "App de celular para catalogar livros: lidos, lendo, quero ler e estante.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run test:coverage && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "vitest": "^3.2.7"
  }
}
